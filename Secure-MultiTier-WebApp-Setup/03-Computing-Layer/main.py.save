def get_messages():

    connection = psycopg2.connect(
        host="10.1.20.219",
        port=5432,
        database="appdb",
        user="appuser",
        password="apppassword"
    )

    cursor = connection.cursor()

    cursor.execute("SELECT id, message FROM messages ORDER BY id")

    rows = cursor.fetchall()

    cursor.close()
    connection.close()

    return [
        {
            "id": row[0],
            "message": row[1]
        }
        for row in rows
    ]
